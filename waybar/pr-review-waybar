#!/usr/bin/env python3
"""Waybar custom module for PR Review.

Reads the status file the app writes after every poll and prints waybar JSON.
Wire it up with "return-type": "json" and "signal": 11 (see README).
"""
import html
import json
import os
import sys
from datetime import datetime, timezone
from pathlib import Path

STATUS = Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache")) / "pr-review" / "status.json"
ICON = ""  # nf-oct-git_pull_request


def emit(text: str, tooltip: str, css_class: str) -> None:
    print(json.dumps({"text": text, "tooltip": html.escape(tooltip), "class": css_class, "alt": css_class}))
    sys.exit(0)


try:
    data = json.loads(STATUS.read_text())
except (OSError, ValueError):
    emit(ICON, "PR Review is not running\nClick to start it", "stale")

age = None
if data.get("updated"):
    try:
        age = (datetime.now(timezone.utc) - datetime.fromisoformat(data["updated"])).total_seconds()
    except ValueError:
        age = None
interval = int(data.get("poll_interval") or 120)
if age is None or age > 3 * interval + 60:
    emit(ICON, "PR Review is not running\nClick to start it", "stale")

count = int(data.get("count") or 0)
prs = data.get("prs") or []
if data.get("error"):
    emit(ICON, f"PR Review: {data['error']}", "error")
if count == 0:
    emit(ICON, "No pull requests waiting for your review", "idle")

lines = [f"{p['key']}  {p['title']}  — {p['author']}" for p in prs[:12]]
if count > len(lines):
    lines.append(f"…and {count - len(lines)} more")
title = f"{count} pull request{'s' if count != 1 else ''} waiting for your review"
emit(f"{ICON} {count}", title + "\n\n" + "\n".join(lines), "pending")
